<?xml version="1.0" encoding="utf-8"?>

<launch>
  <!-- Realsense D435i -->
  <include file="$(find realsense2_camera)/launch/rs_rgbd.launch">
    <arg name="enable_pointcloud" value="true"/>
    <arg name="depth_width" value="640"/>
    <arg name="depth_height" value="480"/>
    <arg name="depth_fps" value="15"/>
    <arg name="color_width" value="640"/>
    <arg name="color_height" value="480"/>
    <arg name="color_fps" value="15"/>
    <param name="queue_size" value="10"/>
  </include>

  <!-- Console launch prefix -->
  <arg name="launch_prefix" default=""/>

  <!-- Depth Combination -->
  <!-- <node pkg="depth_v8" type="depth_combination.py" name="depth_combination" output="screen" /> -->
  <node pkg="depth_v8" type="detect_only_one.py" name="detect_only_one" output="screen" />

  <!-- Static TF -->
  <!-- <node pkg="tf" type="static_transform_publisher" name="camera_link_to_camera_color_optical_frame"
    args="0.06 -0.01 0.09 -1.57 0 -1.57 /link5 /camera_color_optical_frame 100" /> -->

   <!-- RVIZ -->
  <node pkg="rviz" type="rviz" name="rviz"
    args="-d $(find depth_v8)/rviz/test.rviz" />
</launch>
